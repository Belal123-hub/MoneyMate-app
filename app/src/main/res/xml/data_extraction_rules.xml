<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude offline-first Room DB from cloud backup and device transfer so reinstall matches server.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="moneymate_offline.db" />
        <exclude domain="database" path="moneymate_offline.db-shm" />
        <exclude domain="database" path="moneymate_offline.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="moneymate_offline.db" />
        <exclude domain="database" path="moneymate_offline.db-shm" />
        <exclude domain="database" path="moneymate_offline.db-wal" />
    </device-transfer>
</data-extraction-rules>
