<?xml version="1.0" encoding="utf-8"?>
<!--
  MoneyMate local Room DB must not be restored after uninstall/reinstall — it caused “ghost”
  wallets that no longer exist on the server. See OfflineModule database name moneymate_offline.db.
  https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="moneymate_offline.db" />
    <exclude domain="database" path="moneymate_offline.db-shm" />
    <exclude domain="database" path="moneymate_offline.db-wal" />
</full-backup-content>
